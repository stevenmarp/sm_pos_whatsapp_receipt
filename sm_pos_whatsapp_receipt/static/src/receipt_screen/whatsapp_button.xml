<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sm_pos_whatsapp_receipt.WhatsAppButton" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//form[hasclass('send-email')]" position="after">
            <div class="send-whatsapp d-flex mt-2">
                <div class="input-whatsapp input-group">
                    <input type="text" class="form-control py-3 bg-view" placeholder="WhatsApp: e.g. 08123456789" t-model="orderUiState.inputPhone" />
                    <button class="send btn btn-success px-5" type="button" t-on-click="actionSendReceiptOnWhatsApp">
                        <i class="fa fa-whatsapp" aria-hidden="true"/> Send via WhatsApp
                    </button>
                </div>
            </div>
        </xpath>
    </t>
</templates>

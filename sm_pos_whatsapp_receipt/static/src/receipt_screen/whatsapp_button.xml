<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sm_pos_whatsapp_receipt.WhatsAppButton" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//input[hasclass('send-receipt-email-input')]/parent::div" position="after">
            <div class="d-flex mt-2">
                <input type="text" class="send-receipt-phone-input o_input position-relative p-3 border border-end-0 rounded-start-2 text-body" placeholder="WhatsApp: e.g. 08123456789" t-model="state.phone" />
                <div>
                    <button t-att-style="`width: ${this.ui.isSmall ? '4rem' : '8rem'}`" class="btn btn-success btn-lg lh-lg rounded-start-0 h-100" t-on-click="() => this.actionSendReceiptOnWhatsApp()">
                        <i class="fa fa-whatsapp" aria-hidden="true" style="font-size: 20px;"/>
                    </button>
                </div>
            </div>
        </xpath>
    </t>
</templates>
